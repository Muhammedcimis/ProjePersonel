@using PersonelProjesiDataAccess.Models
@model PersonelDTO

@{
    ViewData["Title"] = "Personel Bilgilerini Güncelle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Personel ID</label>
                        <div class="col-sm-8">
                            <input class="form-control-plaintext" readonly value="@ViewBag.PersonelId">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="Adi"></label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Adi">
                            <span asp-validation-for="Adi" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="Soyadi"></label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Soyadi">
                            <span asp-validation-for="Soyadi" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="Cinsiyet"></label>
                        <div class="col-sm-8 pt-2">
                            @foreach (var item in ViewBag.Cinsiyetdata as List<string>)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" asp-for="Cinsiyet" type="radio" value="@item" />
                                    <label class="form-check-label">@item</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="IsZimmet"></label>
                        <div class="col-sm-8">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="IsZimmet" type="checkbox" />
                                <label class="form-check-label" for="IsZimmet">Zimmetli</label>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="Mezuniyet"></label>
                        <div class="col-sm-8">
                            <select asp-for="Mezuniyet" class="form-select" asp-items="new SelectList(Model.MezuniyetBilgisi)"></select>
                            <span asp-validation-for="Mezuniyet" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="Sehir"></label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Sehir">
                            <span asp-validation-for="Sehir" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="Departman"></label>
                        <div class="col-sm-8">
                            <select class="form-select" asp-for="Departman">
                                <option value="Pazarlama">Pazarlama</option>
                                <option value="Satın Alma">Satın Alma</option>
                                <option value="Finans ve Muhasebe">Finans ve Muhasebe</option>
                                <option value="Bilgi İşlem">Bilgi İşlem</option>
                                <option value="Yazılım">Yazılım</option>
                                <option value="İnsan Kaynakları">İnsan Kaynakları</option>
                                <option value="Diger">Diğer</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="DogumTarihi"></label>
                        <div class="col-sm-8">
                            <input type="date" class="form-control" asp-for="DogumTarihi">
                            <span asp-validation-for="DogumTarihi" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label" asp-for="Maas"></label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Maas">
                            <span asp-validation-for="Maas" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-sm-8 offset-sm-4">
                            <button type="submit" class="btn btn-primary me-2">Güncelle</button>
                            <a class="btn btn-secondary" asp-controller="Personel" asp-action="Index" role="button">İptal</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
