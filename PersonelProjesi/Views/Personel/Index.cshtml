@using PersonelProjesiDomain.Models
@model List<Personel>
@{
    Layout = "_Layout";
}
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Personel Listesi</h5>
        <a class="btn btn-primary" asp-controller="Personel" asp-action="Create">
            <i class="fas fa-plus"></i> Yeni Personel Ekle
        </a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>İsim</th>
                    <th>Soyisim</th>
                    <th>Departman</th>
                    <th>Şehir</th>
                    <th>Maaş</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var personel in Model)
                {
                    <tr>
                        <td>@personel.Adi</td>
                        <td>@personel.Soyadi</td>
                        <td>@personel.Departman</td>
                        <td>@personel.Sehir</td>
                        <td>@personel.Maas</td>
                        <td class="text-end">
                            <a class="btn btn-warning btn-sm" asp-controller="Personel" asp-action="Edit" asp-route-id="@personel.Id" title="Düzenle">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a class="btn btn-danger btn-sm" asp-controller="Personel" asp-action="Delete" asp-route-id="@personel.Id" onclick="return confirm('Bu personeli silmek istediğinizden emin misiniz?')" title="Sil">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>